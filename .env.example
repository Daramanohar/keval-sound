# Application
APP_URL=http://localhost:3000
NEXT_PUBLIC_KEVAL_STREAMS_READY=1

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/browse
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_POOL_MAX=3

# Protected media delivery
MEDIA_GATE_BASE_URL=https://media.kevalsound.com
MEDIA_GATE_SIGNING_SECRET=replace_with_at_least_32_random_characters
WAV_REVIEWER_EMAILS=

# Razorpay Checkout and Billing (test mode first)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_a_unique_webhook_secret
# Keep the previous value during webhook-secret rotation until retries have drained.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
RAZORPAY_ALLOW_LIVE_MODE=false
# Maximum monthly billing cycles created for each subscription.
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120

# GST and invoice policy. Prices are tax-inclusive by default so the public
# ₹99/₹49/₹299/₹499/₹999 prices remain the final checkout totals.
KEVAL_GST_RATE_BPS=1800
KEVAL_TAX_PRICING_MODE=inclusive
KEVAL_TRACK_SAC_CODE=997332
KEVAL_SUBSCRIPTION_SAC_CODE=998439
# Keep false until an Indian tax professional confirms the rate, SAC codes,
# pricing mode, and place-of-supply treatment for KEVAL SOUND.
KEVAL_TAX_CONFIG_REVIEWED=false

# Authenticates scheduled maintenance calls. Use at least 32 random characters.
CRON_SECRET=replace_with_at_least_32_random_characters

# Audit-log privacy
AUDIT_IP_HASH_SECRET=replace_with_at_least_32_random_characters

# Semantic search (Cloudflare Workers AI)
CLOUDFLARE_ACCOUNT_ID=replace_me
CLOUDFLARE_AI_API_TOKEN=replace_me
CLOUDFLARE_AI_EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# Optional reranking provider
RERANK_API_URL=
RERANK_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
